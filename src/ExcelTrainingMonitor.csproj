<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishSelfContained>true</PublishSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyVersion>1.0.13.9</AssemblyVersion>
    <FileVersion>1.0.13.9</FileVersion>
    <Version>1.0.4</Version>
    <InformationalVersion>1.0.4</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\Debug\**" />
    <EmbeddedResource Remove="bin\Debug\**" />
    <None Remove="bin\Debug\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Themes\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Copy produced executable to prebuilt/windows-x64 on each build -->
  <PropertyGroup>
    <!-- prebuilt path relative to project directory -->
    <PrebuiltOutputDir>$(MSBuildProjectDirectory)\..\prebuilt\windows-x64\</PrebuiltOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- all theme files to copy into prebuilt output preserving subfolders -->
    <ThemeFiles Include="Themes\**\*.*" />
  </ItemGroup>

  <Target Name="CopyToPrebuilt" AfterTargets="Build">
    <!-- ensure base prebuilt folder exists -->
    <MakeDir Directories="$(PrebuiltOutputDir)" />
    <!-- ensure theme subdirectories exist before copying -->
    <MakeDir Directories="@(ThemeFiles->'$(PrebuiltOutputDir)%(RecursiveDir)')" Condition="@(ThemeFiles-&gt;Count()) &gt; 0" />

    <!-- copy main built executable -->
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(PrebuiltOutputDir)$(TargetFileName)" SkipUnchangedFiles="true" />

    <!-- copy theme files preserving folder structure -->
    <Copy SourceFiles="@(ThemeFiles)" DestinationFiles="@(ThemeFiles->'$(PrebuiltOutputDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
